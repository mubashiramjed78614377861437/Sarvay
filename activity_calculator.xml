<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="end"
        android:minHeight="24dp" />

    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="end"
        android:padding="8dp"
        android:textColor="@color/text_primary" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="true">

        <Button android:id="@+id/btnC" android:text="C" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnBack" android:text="⌫" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnPct" android:text="%" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnDiv" android:text="÷" android:layout_columnWeight="1" />

        <Button android:id="@+id/btn7" android:text="7" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn8" android:text="8" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn9" android:text="9" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnMul" android:text="×" android:layout_columnWeight="1" />

        <Button android:id="@+id/btn4" android:text="4" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn5" android:text="5" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn6" android:text="6" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnMinus" android:text="−" android:layout_columnWeight="1" />

        <Button android:id="@+id/btn1" android:text="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn2" android:text="2" android:layout_columnWeight="1" />
        <Button android:id="@+id/btn3" android:text="3" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnPlus" android:text="+" android:layout_columnWeight="1" />

        <Button android:id="@+id/btn0" android:text="0" android:layout_columnWeight="1" android:layout_columnSpan="2" />
        <Button android:id="@+id/btnDot" android:text="." android:layout_columnWeight="1" />
        <Button android:id="@+id/btnEq" android:text="=" android:layout_columnWeight="1" />
    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit conversion"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="true">

        <Button android:id="@+id/btnMtoKm" android:text="m→km" android:layout_columnWeight="1" android:textSize="12sp" />
        <Button android:id="@+id/btnKmtoM" android:text="km→m" android:layout_columnWeight="1" android:textSize="12sp" />
        <Button android:id="@+id/btnMtoFt" android:text="m→ft" android:layout_columnWeight="1" android:textSize="12sp" />
        <Button android:id="@+id/btnFttoM" android:text="ft→m" android:layout_columnWeight="1" android:textSize="12sp" />
        <Button android:id="@+id/btnSqMtoSqFt" android:text="m²→ft²" android:layout_columnWeight="1" android:textSize="12sp" />
        <Button android:id="@+id/btnSqFttoSqM" android:text="ft²→m²" android:layout_columnWeight="1" android:textSize="12sp" />
    </GridLayout>
</LinearLayout>
